# =============================================================================
# LLM Steward - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# The gateway works out of the box with no API keys (uses local Ollama).
# Add provider keys to enable cloud models.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm
POSTGRES_DB=litellm
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# LiteLLM Gateway
# -----------------------------------------------------------------------------
# Master key for admin operations (change this in production!)
LITELLM_MASTER_KEY=sk-master-key-change-me

# Gateway port
LITELLM_PORT=4000

# -----------------------------------------------------------------------------
# Ollama (Local Models - Zero Cost)
# -----------------------------------------------------------------------------
OLLAMA_PORT=11434
# Default model to pull on startup
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
# Presidio (PII Detection)
# -----------------------------------------------------------------------------
PRESIDIO_ANALYZER_PORT=5001
PRESIDIO_ANONYMIZER_PORT=5002

# -----------------------------------------------------------------------------
# Provider API Keys (Optional)
# -----------------------------------------------------------------------------
# Leave empty for local-only mode. Add keys to enable cloud providers.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-15-preview

# Google (Gemini/Vertex)
GOOGLE_API_KEY=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
